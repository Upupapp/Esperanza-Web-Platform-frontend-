APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# This project is frontend-only and has no database. The drivers below are
# in-memory on purpose -- database drivers against a sqlite file that is not
# in the repo made a fresh clone return HTTP 500 on every page (F-004).
DB_CONNECTION=sqlite
DB_DATABASE=:memory:
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=array
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=array
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# -- API (TAB 05) -------------------------------------------------------------
# In production there is no PHP: the site is a static export on a CDN, so the
# browser calls the API directly and the API origin DIFFERS from the site
# origin. These are read at BUILD time by Vite, not at runtime.
#
# Settled (production-readiness programme, 2026-09-25): the token rides in an
# Authorization: Bearer header, never a cookie, so this never needs
# withCredentials. The backend's CORS config is Laravel's own default
# (no app-level config/cors.php was ever published) -- allowed_origins '*' on
# api/* with supports_credentials false, which is exactly right for a
# bearer-token client and needs no per-origin allowlist to maintain.
#
# Points at the backend's staging deployment by default so a fresh local clone
# talks to something real out of the box. Swap it for `http://localhost:8000/api/v1`
# if you are also running the backend locally (see esperanza-backend/README.md).
VITE_API_BASE_URL=https://esperanza.139-162-51-165.sslip.io/api/v1
VITE_API_TIMEOUT_MS=15000
